# 复制本文件为 .env 并填写真实值。.env 含有密钥，不要提交到版本库。

# 必填：API Key
OPENAI_API_KEY=

# 必填：模型名，例如 gpt-4o-mini / deepseek-chat 等（按你的服务商填写）
OPENAI_MODEL=

# 选填：OpenAI 兼容服务的接口地址。留空则使用 OpenAI 官方地址。
OPENAI_BASE_URL=

# 选填：单次请求超时秒数，默认 60
OPENAI_TIMEOUT=60

# ── LLM 重试（Phase 13.5）────────────────────────────────────────────

# 选填：临时错误（429 限流 / 5xx / 连接不上 / 超时）最多再重试几次，
# 默认 2（= 最多 3 次尝试）。0 = 一次就抛。参数错、认证失败、模型不存在
# 这些不重试——重试多少次结果都一样。退避按指数涨，且随时可被取消打断。
LLM_MAX_RETRIES=2

# 选填：每次重试前的基础退避秒数，默认 0.5（第一次等 0.5 秒，第二次 1 秒，
# 以此类推）。0 = 不等待（立即重试，测试里常用）
LLM_RETRY_BACKOFF=0.5

# 选填：search_code_chunks 的检索模式，默认 off（纯字面检索，行为和以前一样）
# off / fake / local / multilingual
# fake       = 离线假 embedding（演示用，不需要额外依赖）
# local      = 本地英文小模型 all-MiniLM-L6-v2（需 pip install sentence-transformers）
# multilingual = 本地多语言模型（中文查询用这个）
# 模型到第一次调用该工具时才加载；向量缓存在用户目录 ~/.cache/universal-code-agent
SEARCH_CHUNKS_EMBEDDING=off

# ── Memory（Phase 11）────────────────────────────────────────────────

# 选填：任务历史记忆的开关。默认 on（第一轮就是空库，没有额外行为）；
# 设 off 整个关掉，Agent 一行 Memory 代码都不走。
AGENT_MEMORY=on

# 选填：历史数据文件位置。留空用默认：
# ~/.cache/universal-code-agent/memory.jsonl（项目之外，不会被代码索引扫到）。
AGENT_MEMORY_PATH=

# 选填：最多留几条历史（默认 500）、文件最多多少字节（默认 2 MiB）。
# 超了自动丢最旧的，永远保留最新。只认正整数。
AGENT_MEMORY_MAX_RECORDS=500
AGENT_MEMORY_MAX_BYTES=2097152

# ── HTTP 服务（python -m api，Phase 13.3）─────────────────────────────

# 选填：会话多久没人用就过期清理（秒），默认 3600
API_SESSION_TTL=3600

# 选填：最多同时保留几个会话，超了丢最久没用的那个，默认 32
API_MAX_SESSIONS=32

# 选填：允许跨源访问的前端 Origin（逗号分隔），默认空 = 不放行任何浏览器前端。
# 不接受 *（放行整个 Web 太危险）；命令行客户端不带 Origin，不受影响。
# 例如：http://localhost:5173,http://127.0.0.1:5173
API_CORS_ORIGINS=

# 选填：接口 Token。留空 = 本机开发直接可用；设了之后除 GET /api/health 外，
# 所有接口都要带 Authorization: Bearer <token>
API_TOKEN=

# ── 整轮超时（Phase 13.4）────────────────────────────────────────────

# 选填：一次 Run 的总预算（秒），从请求受理到结束，LLM + 工具 + 修复共享。
# 默认 0 = 不限时（本地跑长任务很常见）。设了正数就到点按「运行超时」停下：
# 是协作式的——Agent 在下一个检查点停，不硬杀进程；单个工具自己的 timeout
# 照旧生效（工具超时只是工具结果，整轮超时才是这一轮被停下）。
AGENT_RUN_TIMEOUT=0
