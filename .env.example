# 复制本文件为 .env 并填写真实值。.env 含有密钥，不要提交到版本库。

# 必填：API Key
OPENAI_API_KEY=

# 必填：模型名，例如 gpt-4o-mini / deepseek-chat 等（按你的服务商填写）
OPENAI_MODEL=

# 选填：OpenAI 兼容服务的接口地址。留空则使用 OpenAI 官方地址。
OPENAI_BASE_URL=

# 选填：单次请求超时秒数，默认 60
OPENAI_TIMEOUT=60

# 选填：search_code_chunks 的检索模式，默认 off（纯字面检索，行为和以前一样）
# off / fake / local / multilingual
# fake       = 离线假 embedding（演示用，不需要额外依赖）
# local      = 本地英文小模型 all-MiniLM-L6-v2（需 pip install sentence-transformers）
# multilingual = 本地多语言模型（中文查询用这个）
# 模型到第一次调用该工具时才加载；向量缓存在用户目录 ~/.cache/universal-code-agent
SEARCH_CHUNKS_EMBEDDING=off
